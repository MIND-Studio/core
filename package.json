{
  "name": "@mind-studio/core",
  "version": "0.1.1",
  "description": "Shared core for Mind prototypes — the unified login card, plus pod-backed business logic and components (app launcher).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MIND-Studio/core.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./apps": {
      "types": "./dist/apps/index.d.ts",
      "import": "./dist/apps/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher/index.d.ts",
      "import": "./dist/launcher/index.js"
    },
    "./login-card.css": "./dist/login-card.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/login-card.css dist/login-card.css",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@inrupt/solid-client": "^3.0.0",
    "@mind-studio/ui": "*",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@inrupt/solid-client": {
      "optional": true
    },
    "@mind-studio/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inrupt/solid-client": "^3.0.0",
    "@mind-studio/ui": "^0.1.0",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19",
    "react-dom": "^19.2.6",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "vite": "^7.3.3"
  }
}
